@model IEnumerable<ArticoloModel>

<a class="btn btn-success" asp-action="Create">Inserisci nuovo articolo</a>

<ul class="list-group">
    @foreach(var a in Model)
    {
        <li class="list-group-item">
            <a asp-controller="Articoli" asp-action="Dettaglio" asp-route-id="@a.Id">
                @a.Titolo
            </a>
        </li>
    }
</ul>

